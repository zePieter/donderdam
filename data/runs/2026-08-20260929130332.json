  "response_text": "{\n  \"signalen\": [\n    {\n      \"kpi_code\": \"INW\",\n      \"signaal\": \"Op koers\",\n      \"richting\": \"verbetert\",\n      \"kop\": \"Inwonersaantal blijft gestaag groeien in Donderdam\",\n      \"duiding\": \"Het inwonersaantal stijgt al maanden continu naar 41794 inwoners, waarmee het het doel van 41301 overtreft. De groei is stabiel over bijna alle wijken zichtbaar.\",\n      \"zekerheid\": \"hoog\"\n    },\n    {\n      \"kpi_code\": \"WON\",\n      \"signaal\": \"Aandacht\",\n      \"richting\": \"verslechtert\",\n      \"kop\": \"Woningbouw blijft achter bij het jaardoel\",\n      \"duiding\": \"Met 91 opgeleverde woningen tegenover een doel van 106,7 loopt de gemeente al 5 maanden op rij achter. Met name projecten in Zuidrand en Donderdam West blijven achter.\",\n      \"zekerheid\": \"hoog\"\n    },\n    {\n      \"kpi_code\": \"WLH\",\n      \"signaal\": \"Afwijkende trend\",\n      \"richting\": \"verslechtert\",\n      \"kop\": \"Sterke stijging werkloosheid in Donderdam West\",\n      \"duiding\": \"De werkloosheid stijgt al 32 maanden ongunstig t.o.v. het doel en bereikt 8,2 procent. Dit wordt gedreven door een enorme uitschieter in Donderdam West.\",\n      \"zekerheid\": \"hoog\"\n    },\n    {\n      \"kpi_code\": \"CO2\",\n      \"signaal\": \"Aandacht\",\n      \"richting\": \"stabiel\",\n      \"kop\": \"CO2-uitstoot blijft structureel te hoog door industrie\",\n      \"duiding\": \"De totale uitstoot bedraagt 1849,5 ton en overschrijdt het doel van 1692,7 ton. Binnenstede en De Havenmeent veroorzaken samen de grootste overschrijding in de sector Industrie.\",\n      \"zekerheid\": \"hoog\"\n    }\n  ],\n  \"wijkduidingen\": [\n    {\n      \"kpi_code\": \"WLH\",\n      \"wijk_id\": 8,\n      \"observatie\": \"De werkloosheid in Donderdam West is extreem gestegen naar 12,3 procent, met hoge percentages in alle leeftijdsgroepen.\",\n      \"hypothese\": \"Mogelijke sluitingen of reorganisaties bij lokale werkgevers raken alle actieve leeftijdsgroepen zwaar.\",\n      \"bewijs\": [\n        \"wijk:8\",\n        \"leeftijd:15-26 jaar\",\n        \"leeftijd:27-49 jaar\",\n        \"leeftijd:50-67 jaar\"\n      ],\n      \"te_toetsen\": \"Of er specifieke bedrijfssluitingen of faillissementen in Donderdam West hebben plaatsgevonden.\",\n      \"zekerheid\": \"middel\"\n    },\n    {\n      \"kpi_code\": \"WON\",\n      \"wijk_id\": 6,\n      \"observatie\": \"In Zuidrand is er een grote achterstand bij het project Zuidrand Oost met een aanzienlijke vertraging.\",\n      \"hypothese\": \"Problemen bij uitvoerende partij Van Rijn Bouwcombinatie veroorzaken de flinke vertraging in de koopsector.\",\n      \"bewijs\": [\n        \"wijk:6\",\n        \"project:P-18\"\n      ],\n      \"te_toetsen\": \"Of de vertraging wordt veroorzaakt door capaciteitsproblemen bij Van Rijn Bouwcombinatie of vertraagde vergunningsprocedures.\",\n      \"zekerheid\": \"hoog\"\n    },\n    {\n      \"kpi_code\": \"CO2\",\n      \"wijk_id\": 4,\n      \"observatie\": \"Binnenstede heeft met 408,2 ton de hoogste CO2-uitstoot van alle wijken, flink boven het doel van 286 ton.\",\n      \"hypothese\": \"De zware industrie en het drukke verkeer in deze centrale wijk veroorzaken de hoge milieubelasting.\",\n      \"bewijs\": [\n        \"wijk:4\",\n        \"sector:Industrie\",\n        \"sector:Verkeer\"\n      ],\n      \"te_toetsen\": \"Of specifieke industriële processen in Binnenstede hun productiecapaciteit hebben verhoogd.\",\n      \"zekerheid\": \"hoog\"\n    }\n  ],\n  \"aanbevelingen\": [\n    {\n      \"kpi_code\": \"WON\",\n      \"titel\": \"Gesprek met bouwpartners over achterstanden\",\n      \"voorstel\": \"Plan een bestuurlijk overleg met Van Rijn Bouwcombinatie en De Waal & Zn om de knelpunten bij achterblijvende bouwprojecten te bespreken.\",\n      \"waarom\": \"De woningbouwproductie loopt al 5 maanden achter op het doel en grote projecten zoals Zuidrand Oost en Bergse Tuinen tonen flinke achterstanden.\",\n      \"te_toetsen\": \"Of de vertragingen in de bouw op korte termijn kunnen worden ingelopen.\",\n      \"wijk_ids\": [\n        6,\n        7\n      ]\n    },\n    {\n      \"kpi_code\": \"WLH\",\n      \"titel\": \"Gerichte arbeidsmarktinterventie Donderdam West\",\n      \"voorstel\": \"Zet extra middelen in voor omscholing en bemiddeling in samenwerking met de openstaande vacatures in Handel & Logistiek en Zorg & Welzijn.\",\n      \"waarom\": \"De werkloosheid in Donderdam West is opgelopen tot 12,3 procent en treft alle leeftijdsgroepen in deze wijk ernstig.\",\n      \"te_toetsen\": \"Of werkzoekenden in Donderdam West aansluiten bij de sectoren waar de meeste vacatures openstaan.\",\n      \"wijk_ids\": [\n        8\n      ]\n    },\n    {\n      \"kpi_code\": \"CO2\",\n      \"titel\": \"Onderzoek industriële emissies Binnenstede en De Havenmeent\",\n      \"voorstel\": \"Start een dialoog met de grootste industriële uitstoters in Binnenstede en De Havenmeent over verduurzamingsmaatregelen.\",\n      \"waarom\": \"Deze twee wijken overschrijden de CO2-doelstellingen ruimschoots en drukken zwaar op de totale uitstoot van de gemeente.\",\n      \"te_toetsen\": \"Welke concrete reductiemaatregelen de industrie kan treffen om de uitstoot binnen het doel te brengen.\",\n      \"wijk_ids\": [\n        4,\n        5\n      ]\n    }\n  ]\n}"
